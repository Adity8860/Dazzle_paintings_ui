# Environment Configuration for Development
VITE_APP_ENV=development
VITE_APP_NAME=Dazzle Painting
# VITE_API_BASE_URL=http://localhost:4000/
VITE_ENABLE_DEBUG=true
VITE_APP_VERSION=1.0.0

# Server Configuration
VITE_PORT=5173
VITE_PUBLIC_PATH=/

# Feature Flags (Enable/Disable Features in Dev Mode)
# VITE_FEATURE_NEW_DESIGN=true
# VITE_FEATURE_EXPERIMENTAL=false

# Third-Party API Keys (Use placeholders, don’t expose real keys)
# VITE_GOOGLE_MAPS_API_KEY=your-dev-google-maps-key
# VITE_EMAILJS_SERVICE_ID=your-dev-emailjs-service-id
# VITE_EMAILJS_TEMPLATE_ID=your-dev-emailjs-template-id
# VITE_EMAILJS_USER_ID=your-dev-emailjs-user-id
